# Copy to .env.local. Never commit real values.

# Postgres (Supabase: use the pooled "Transaction" connection string).
# Leave unset in development to run on a local in-process database (./.data).
DATABASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional. The Google button is hidden until both are set.
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, for Google sign-in inside the iPhone app: the "iOS" OAuth client id
# from the same Google Cloud project (bundle id com.anchorforgedigital.almanac).
GOOGLE_IOS_CLIENT_ID=

# Optional. The coach shows a "not configured" state until this is set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_FALLBACK_MODEL=openai/gpt-6-luna
# Coach replies per person per day, and a spending backstop in US dollars.
COACH_DAILY_MESSAGES=10
COACH_DAILY_USD_CAP=0.10
COACH_MESSAGES_PER_MINUTE=6

# Free key from https://fdc.nal.usda.gov/api-key-signup. DEMO_KEY is heavily rate limited.
USDA_API_KEY=DEMO_KEY

# "deny" (default) routes coach requests only to providers that do not store or train on prompts.
OPENROUTER_DATA_COLLECTION=deny

# Password reset email. Free key from https://resend.com. EMAIL_FROM must be on a domain verified there.
RESEND_API_KEY=
EMAIL_FROM=Almanac <onboarding@resend.dev>

# Countries where sign-up is open (ISO codes, comma-separated; * for all).
ALLOWED_COUNTRIES=US

# Shown on the privacy and terms pages.
OPERATOR_NAME=
CONTACT_EMAIL=
