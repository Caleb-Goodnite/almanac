{
  "name": "almanac",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local lib/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local lib/db/seed.ts",
    "db:demo": "tsx --env-file-if-exists=.env.local lib/db/seed-demo.ts",
    "support:clear": "tsx --env-file-if-exists=.env.local lib/db/support-clear.ts",
    "eval:coach": "vitest run --config vitest.eval.config.mts",
    "mobile:sync": "cap sync",
    "mobile:android": "cap sync android && cd android && ./gradlew assembleDebug",
    "mobile:android:install": "cap sync android && cd android && ./gradlew installDebug",
    "mobile:ios": "cap sync ios && cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capgo/capacitor-health": "8.11.8",
    "@electric-sql/pglite": "^0.5.8",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.1",
    "@visx/curve": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0"
}
